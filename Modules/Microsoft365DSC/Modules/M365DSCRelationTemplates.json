{
  "templates": {
    "IntuneAssignments": {
      "relations": [
        {
          "property": "Assignments",
          "childProperty": "groupDisplayName",
          "targetResource": "AADGroup",
          "targetKeyProperty": "DisplayName",
          "condition": "dataType in ['#microsoft.graph.groupAssignmentTarget', '#microsoft.graph.exclusionGroupAssignmentTarget']"
        },
        {
          "property": "Assignments",
          "childProperty": "deviceAndAppManagementAssignmentFilterDisplayName",
          "targetResource": "IntuneDeviceAndAppManagementAssignmentFilter",
          "targetKeyProperty": "DisplayName"
        }
      ],
      "resources": [
        "IntuneAccountProtectionLocalAdministratorPasswordSolutionPolicy",
        "IntuneAntivirusExclusionsPolicyMacOS"
      ]
    },
    "IntuneRootCertificateProfile": {
      "relations": [
        {
          "property": "RootCertificateDisplayName",
          "targetResource": "IntuneDeviceConfigurationTrustedCertificatePolicyWindows10",
          "targetKeyProperty": "DisplayName"
        },
        {
          "$ref": "#/templates/IntuneAssignments"
        }
      ],
      "resources": [
        "IntuneDeviceConfigurationSCEPCertificatePolicyWindows10"
      ]
    }
  }
}
